DATABASE_URL="postgresql://user:password@localhost:5432/frental"

JWT_SECRET="replace-with-a-long-random-secret"

# Brevo (transactional email — signup verification, password reset, change-email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Frental

# Google Sign-In — Web Client ID from Google Cloud Console (OAuth consent
# screen + credentials). Used to verify the idToken the app sends after
# Google Sign-In. Must match the client ID the Android app was built with.
GOOGLE_CLIENT_ID=

# API_BASE_URL is no longer used — every auth email (verification,
# password reset, change-email) now sends a 6-digit code instead of a
# clicked link, so nothing needs to embed this server's own URL. Kept out
# entirely rather than left as dead config.

# MinIO (local dev) / R2 or other S3-compatible provider (production)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=frental-media
MINIO_REGION=us-east-1

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (BullMQ)
# Local dev (Docker, no auth): use REDIS_HOST + REDIS_PORT
REDIS_HOST=localhost
REDIS_PORT=6379
# Production (Render/Upstash managed Redis, requires auth + TLS): set REDIS_URL
# instead — when present, it takes priority over REDIS_HOST/REDIS_PORT.
# REDIS_URL=rediss://default:<password>@<host>:<port>

PORT=4000

# Set to "true" only on a free-tier deployment with no separate worker service
# (e.g. Render free tier) — runs the media worker in the same process as the API.
# Leave unset locally; run `npm run worker` as its own process instead.
# RUN_WORKER_INLINE=true
